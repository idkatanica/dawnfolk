{
  "$schema": "https://www.schemastore.org/package.json",
  "name": "dawnfolk",
  "version": "0.3.3",
  "private": true,
  "description": "A god game about the first tribes on a floating island",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "check": "ultracite check",
    "deploy": "bun run build && wrangler deploy",
    "dev": "vite",
    "fix": "ultracite fix",
    "prepare": "lefthook install",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "typecheck": "tsc --build"
  },
  "overrides": {
    "@svidskiy/glass-surface": "file:vendor/svidskiy-glass-surface-1.0.0.tgz"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@svidskiy/glass-surface-react": "file:vendor/svidskiy-glass-surface-react-1.0.0.tgz",
    "clsx": "^2.1.1",
    "comlink": "^4.4.2",
    "lucide-react": "^1.59.0",
    "pure-rand": "^8.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "simplex-noise": "^4.0.3",
    "tailwind-merge": "^3.7.0",
    "three": "^0.186.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/core": "^8.0.7",
    "@biomejs/biome": "2.5.15",
