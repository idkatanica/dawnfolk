    "@tailwindcss/vite": "^4.3.3",
    "@tsconfig/bases": "^1.0.28",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser": "^5.0.5",
    "@vitest/browser-playwright": "^5.0.5",
    "babel-plugin-react-compiler": "^1.0.0",
    "lefthook": "^2.2.2",
    "playwright": "^1.64.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "ultracite": "^8.0.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
