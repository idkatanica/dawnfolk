{
  "$schema": "https://www.schemastore.org/tsconfig",
  "extends": ["@tsconfig/bases/strictest", "@tsconfig/bases/vite-react"],
  "compilerOptions": {
    "composite": true,
    "declarationDir": "./node_modules/.tmp/types/node",
    "emitDeclarationOnly": true,
    "noEmit": false,
    "tsBuildInfoFile": "./node_modules/.tmp/node.tsbuildinfo",
    "types": ["node"]
  },
  "include": ["playwright.config.ts", "tests", "vite.config.ts"],
  "references": [{ "path": "./tsconfig.engine.json" }, { "path": "./tsconfig.app.json" }]
}
